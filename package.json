{
  "name": "nooboss-mv3",
  "version": "1.1.0",
  "description": "Modern Chrome extension manager with groups and AutoState - MV3 rebuild of NooBoss",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/runner.mjs",
    "lint": "eslint src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "package": "node scripts/build-release-zip.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@crxjs/vite-plugin": "^2.0.0-beta.30",
    "@preact/preset-vite": "^2.9.4",
    "@types/chrome": "^0.0.304",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.28.0",
    "puppeteer": "^24.9.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "material-symbols": "^0.46.0",
    "preact": "^10.26.9"
  }
}